# Copy to .env (gitignored) and fill in.
# Long random token the interface sends with every request: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=
# Address to listen on: this computer's Tailscale IP (tailscale ip -4), so only your devices reach it.
JARVIS_HOST=100.x.y.z
JARVIS_PORT=8700
# Where the job-finder checkout lives, and the vault roadmap the interface reads phases from.
JOBFINDER_DIR=../job-finder
ROADMAP_PATH=

# Optional: long-lived token from `claude setup-token`, used by Ask Jarvis (headless Claude Code).
# Leave empty to use the claude CLI's own login.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: the Obsidian vault Jarvis reads (the folder with CLAUDE_INDEX.md). Found from ROADMAP_PATH when unset.
VAULT_DIR=

# Optional: the Ollama model for light requests (the router's "local" choice); "off" turns it off.
JARVIS_LOCAL_MODEL=gemma4:latest
# Optional: pages allowed to call this Brain from another origin. Default: the backup page on a laptop,
# http://127.0.0.1:<port> and http://localhost:<port>. Every /api call still needs the token.
JARVIS_CORS_ORIGINS=
# Optional: where chats and the run log are kept. Default: data
JARVIS_DATA_DIR=

# On the laptop backup only (scripts/setup_backup.ps1 writes these): JARVIS_ROLE=backup, JARVIS_HOST=127.0.0.1,
# and JARVIS_PRIMARY_URL=http://<desktop Tailscale IP>:8700, the desktop the page tries first.
JARVIS_ROLE=desktop

# The daily brief of mail and calendar (desktop only; read-only access).
# Mail: the account and a Google app password (Google Account > Security > App passwords). Never marked read.
BRIEF_EMAIL_ACCOUNT=
BRIEF_EMAIL_APP_PASSWORD=
# Calendars: secret iCal addresses, comma separated (Google Calendar > Settings > the calendar >
# Secret address in iCal format). They are secrets: anyone with the address can read the calendar.
BRIEF_CALENDAR_URLS=
BRIEF_TIME=07:30
# Telegram for the brief; job-finder's TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are used when these are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
