# Copy to .env (gitignored) and fill in.
# Long random token the interface sends with every request: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=
# Address to listen on: this computer's Tailscale IP (tailscale ip -4), so only your devices reach it.
JARVIS_HOST=100.x.y.z
JARVIS_PORT=8700
# Where the job-finder checkout lives, and the vault roadmap the interface reads phases from.
JOBFINDER_DIR=../job-finder
ROADMAP_PATH=
